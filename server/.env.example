# The platform runs on managed PostgreSQL. Neon is the default target: copy the
# "Pooled connection" string from the Neon console (Project → Connection
# details) and keep the `?sslmode=require` suffix — it is what switches
# node-postgres (and drizzle-kit) on to TLS.
#
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-1.aws.neon.tech/dbname?sslmode=require"
#
# A local cluster keeps working for offline development, so nothing here has to
# change when you are away from the network:
DATABASE_URL="postgresql://insurance:YOUR_DB_PASSWORD@localhost:5432/insurance_db"

# How the API talks to PostgreSQL:
#   auto  (default) — "neon" for *.neon.tech / *.neon.ai hosts, "pg" otherwise
#   neon            — Neon's serverless driver over HTTPS (drizzle-orm/neon-http)
#   pg              — node-postgres connection pool over TCP + TLS
DB_DRIVER=auto

# Pool size for DB_DRIVER=pg only; the HTTP driver holds no connections open.
# DATABASE_POOL_MAX=10

# Only for `npm run test:driver`: a second cluster that the offline Neon gateway may
# forward to, when DATABASE_URL itself is not reachable over the wire protocol.
# LOCAL_DATABASE_URL="postgresql://insurance:YOUR_DB_PASSWORD@localhost:5432/insurance_db"

JWT_SECRET="YOUR_JWT_SECRET"
JWT_EXPIRES_IN="1d"
PORT=5000
