# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` in the same folder and fill it in:
#
#     cp server/.env.example server/.env
#     npm run db:ping          # proves the values work before anything else runs
#
# `.env` is ignored by git (server/.gitignore) — nothing in it is ever committed.
# Every value below can also be set in the process environment; the environment
# wins over this file.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
# The platform runs on managed PostgreSQL, Neon by default. In the Neon console:
# Project → Connection details → "Pooled connection" (the host ends in `-pooler…`),
# and keep the `?sslmode=require` suffix — it is what turns TLS on for
# node-postgres and for drizzle-kit (`db:migrate`, `db:push`, `db:studio`).
#
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
#
# A local cluster for offline development (same schema, same queries):
DATABASE_URL="postgresql://insurance:YOUR_DB_PASSWORD@localhost:5432/insurance_db"

# How the API talks to PostgreSQL:
#   auto   (default) → "neon" for *.neon.tech / *.neon.ai hosts, "pg" for anything else
#   neon             → Neon's serverless driver over HTTPS: no sockets held open,
#                      works on serverless runtimes, cannot exhaust a Neon pool
#   pg               → node-postgres connection pool over TCP + TLS (or a local socket)
# Both run the same Drizzle queries against the same schema.
DB_DRIVER=auto

# Pool size, DB_DRIVER=pg only (the HTTP driver keeps no connections).
# DATABASE_POOL_MAX=10

# ─── Auth ────────────────────────────────────────────────────────────────────
# At least 32 characters, different per environment. Generate one with:
#
#     openssl rand -hex 32
#
JWT_SECRET="YOUR_JWT_SECRET"
JWT_EXPIRES_IN="1d"

# ─── Server ───────────────────────────────────────────────────────────────────
# The port the API listens on (the client's dev proxy assumes 5000).
PORT=5000

# ─── Optional: development & test helpers ─────────────────────────────────────
# Not needed to run the app. They exist so the Neon code path can be exercised on a
# machine with no route to Neon — see docs/testing.md §10.
#
# The cluster `npm run db:gateway` forwards to, when DATABASE_URL itself is not
# reachable over the wire protocol:
# LOCAL_DATABASE_URL="postgresql://insurance:YOUR_DB_PASSWORD@localhost:5432/insurance_db"
#
# Point Neon's HTTP driver at another gateway (the local stand-in runs on :5433):
# NEON_FETCH_ENDPOINT="http://127.0.0.1:5433/sql"
#
# Where the API suites send their requests:
# API_BASE_URL="http://127.0.0.1:5000"
