# The only database this API supports is a Neon project — there is nothing to
# install locally. In the Neon console: Project → Connection details →
# "Pooled connection" (the host ends in `-pooler…`), then:
#
#     cp server/.env.example server/.env
#     npm run db:ping      # proves the string works before anything else runs
#     npm run db:migrate   # creates the schema in Neon
#
# Keep `?sslmode=require`: `drizzle-kit` (db:migrate, db:push, db:studio) reaches
# Neon over the wire protocol, and that is what switches TLS on for it. The API
# itself talks to Neon's HTTPS gateway, where TLS is implicit.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ─── Auth ────────────────────────────────────────────────────────────────────
# At least 32 characters, different per environment. Generate one with:
#
#     openssl rand -hex 32
#
JWT_SECRET="YOUR_JWT_SECRET"
JWT_EXPIRES_IN="1d"

# ─── Server ───────────────────────────────────────────────────────────────────
# The port the API listens on (the client's dev proxy assumes 5000).
PORT=5000

# ─── Optional ─────────────────────────────────────────────────────────────────
# Send Neon's driver requests through a gateway of your own (an egress proxy, or a
# stand-in for the Neon protocol in CI). Leave unset to talk to the project directly.
# NEON_FETCH_ENDPOINT="https://my-proxy.internal/neon/sql"
#
# Where the API suites send their requests.
# API_BASE_URL="http://127.0.0.1:5000"
