# Local environment — connection strings and secrets never go into git.
#
# The API reads `server/.env` at boot (`import 'dotenv/config'`), and
# `.env.example` next to it is the committed template — hence the re-inclusion
# below, because `.env.*` on its own would swallow that file too.
.env
.env.local
.env.*.local
!.env.example

# Runtime files — uploads written to disk by the document routes (Day 7).
# The directory itself stays tracked through its .gitkeep.
uploads/*
!uploads/.gitkeep

# A local PostgreSQL cluster created inside the workspace for offline work
# (docs/database.md → "Setup — local PostgreSQL"): multi-gigabyte data dirs.
pgdata/
pgdata-*/

# Tooling output
node_modules/
.turbo/
dist/
coverage/
*.log
npm-debug.log*

# Editor & OS noise, so this workspace also behaves when checked out on its own
.DS_Store
Thumbs.db
.vscode/
.idea/
