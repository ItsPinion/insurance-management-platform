{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["**/.env", "**/.env.*local"],
  "globalEnv": [
    "DATABASE_URL",
    "DATABASE_POOL_MAX",
    "DB_DRIVER",
    "LOCAL_DATABASE_URL",
    "NEON_FETCH_ENDPOINT",
    "JWT_SECRET",
    "JWT_EXPIRES_IN",
    "PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": [
        "API_BASE_URL",
        "APP_URL",
        "CHROME_PATH",
        "DATABASE_URL",
        "DB_DRIVER",
        "FONTCONFIG_PATH",
        "HOME",
        "JWT_SECRET",
        "LD_LIBRARY_PATH",
        "NEON_FETCH_ENDPOINT",
        "NODE_OPTIONS"
      ]
    },
    "test:schema": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": [
        "DATABASE_URL",
        "DB_DRIVER",
        "JWT_SECRET",
        "NEON_FETCH_ENDPOINT",
        "NODE_OPTIONS"
      ]
    },
    "test:login": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": [],
      "env": [
        "APP_URL",
        "CHROME_PATH",
        "FONTCONFIG_PATH",
        "HOME",
        "LD_LIBRARY_PATH"
      ]
    },
    "screenshots": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": [],
      "env": [
        "APP_URL",
        "CHROME_PATH",
        "FONTCONFIG_PATH",
        "HOME",
        "LD_LIBRARY_PATH",
        "OUT_DIR"
      ]
    },
    "test:driver": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["DATABASE_URL", "LOCAL_DATABASE_URL", "DB_DRIVER", "NEON_FETCH_ENDPOINT", "NODE_OPTIONS"]
    },
    "test:parity": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": [
        "API_BASE_URL",
        "DATABASE_URL",
        "DB_DRIVER",
        "JWT_SECRET",
        "NEON_FETCH_ENDPOINT",
        "NODE_OPTIONS"
      ]
    },
    "db:generate": {
      "cache": false,
      "outputs": [],
      "env": ["DATABASE_URL"]
    },
    "db:migrate": {
      "cache": false,
      "outputs": [],
      "env": ["DATABASE_URL"]
    },
    "db:push": {
      "cache": false,
      "outputs": [],
      "env": ["DATABASE_URL"]
    },
    "db:ping": {
      "cache": false,
      "outputs": []
    },
    "db:gateway": {
      "cache": false,
      "persistent": true,
      "outputs": []
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL"]
    },
    "db:seed": {
      "cache": false,
      "outputs": [],
      "env": ["DATABASE_URL"]
    },
    "db:seed:demo": {
      "cache": false,
      "outputs": [],
      "env": ["DATABASE_URL"]
    },
    "db:reset": {
      "cache": false,
      "outputs": [],
      "env": ["DATABASE_URL"]
    }
  }
}
