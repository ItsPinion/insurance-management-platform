{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["**/.env", "**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": [
        "API_BASE_URL",
        "APP_URL",
        "CHROME_PATH",
        "FONTCONFIG_PATH",
        "HOME",
        "LD_LIBRARY_PATH",
        "NODE_OPTIONS"
      ]
    },
    "test:schema": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["NODE_OPTIONS"]
    },
    "test:login": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": [],
      "env": [
        "APP_URL",
        "CHROME_PATH",
        "FONTCONFIG_PATH",
        "HOME",
        "LD_LIBRARY_PATH"
      ]
    },
    "screenshots": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": [],
      "env": [
        "APP_URL",
        "CHROME_PATH",
        "FONTCONFIG_PATH",
        "HOME",
        "LD_LIBRARY_PATH",
        "OUT_DIR"
      ]
    },
    "test:parity": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["API_BASE_URL", "DATABASE_URL", "NODE_OPTIONS"]
    },
    "db:generate": {
      "cache": false,
      "outputs": [],
      "env": ["DATABASE_URL"]
    },
    "db:migrate": {
      "cache": false,
      "outputs": [],
      "env": ["DATABASE_URL"]
    },
    "db:push": {
      "cache": false,
      "outputs": [],
      "env": ["DATABASE_URL"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL"]
    },
    "db:seed": {
      "cache": false,
      "outputs": [],
      "env": ["DATABASE_URL"]
    },
    "db:seed:demo": {
      "cache": false,
      "outputs": [],
      "env": ["DATABASE_URL"]
    },
    "db:reset": {
      "cache": false,
      "outputs": [],
      "env": ["DATABASE_URL"]
    }
  }
}
